# Copier en .env (jamais versionné) :  cp .env.example .env   (Windows : copy .env.example .env)

# Serveur Ollama du PC Hôte (déjà installé pour la démo)
OLLAMA_URL=http://127.0.0.1:11434

# Modèle de réponse : PAS de valeur par défaut. Copier ici le nom EXACT affiché par
# `ollama list` sur le PC Hôte (par ex. le Qwen 9B déjà présent, « qwen2.5:7b », etc.).
RAG_MODEL=

# Modèle d'embeddings (petit, rapide) ; `ollama pull nomic-embed-text` si absent
EMBED_MODEL=nomic-embed-text

# Interface (8000 est pris par le back-office)
# HOST=127.0.0.1
# PORT=8001
