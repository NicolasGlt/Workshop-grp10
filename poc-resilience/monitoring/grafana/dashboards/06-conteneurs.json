        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"resilience-alpha.*\"}[1m]))",
          "legendFormat": "{{name}}",
          "refId": "A",
