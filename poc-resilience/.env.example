# Copier en .env puis remplacer TOUTES les valeurs :  cp .env.example .env
# Générer des secrets :  openssl rand -base64 32

POSTGRES_DB=payments
POSTGRES_USER=db_admin
POSTGRES_PASSWORD=change-me-admin

# Rôle applicatif (privilèges minimaux) et rôle de l'exporter Prometheus
APP_DB_PASSWORD=change-me-app
EXPORTER_DB_PASSWORD=change-me-exporter

# Signature des JWT (32+ caractères aléatoires)
JWT_SECRET=change-me-with-a-long-random-string

GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Console pgAdmin (http://localhost:5050) — email de connexion + mot de passe
PGADMIN_EMAIL=admin@resilience.local
PGADMIN_PASSWORD=change-me-pgadmin

# Clé API du marchand de démo — doit rester identique à celle de db/init/03-seed.sql
MERCHANT_API_KEY=pk_nova_demo_bYtR7xQ2
# Base navigateur de la page de checkout (laisser http://localhost en local)
PUBLIC_BASE_URL=http://localhost

# Token partagé entre le détecteur ML et le moteur de remédiation (change-me)
REMEDIATION_TOKEN=change-me-remediation
# IP jamais bloquées par la remédiation (séparées par des virgules) — ajoute ton poste au besoin
SAFE_IPS=127.0.0.1
