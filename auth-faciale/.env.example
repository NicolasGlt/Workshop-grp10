# Copier en .env (jamais versionné) :  cp .env.example .env
# Base du back-office : rôle backoffice du PostgreSQL de poc-resilience (publié sur 127.0.0.1:5432)
BACKOFFICE_DB_PASSWORD=change-me-backoffice     # même valeur que dans poc-resilience/.env
# DATABASE_URL=postgresql://backoffice:<mdp>@127.0.0.1:5432/payments   # forme complète, prioritaire

# Webcam USB : index OpenCV (Windows : 1 si une webcam est intégrée ; Linux : n° de /dev/videoN)
CAM_INDEX=1

# ESP8266 : IP fixe sur le point d'accès RESILIENCE-G10, jeton identique à esp8266/include/secrets.h
LED_URL=http://192.168.137.200
# LED_TOKEN=...                                  # sinon lu dans esp8266/include/secrets.h

# Signature des sessions (sinon aléatoire à chaque démarrage)
# SESSION_SECRET=...
